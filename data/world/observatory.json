  "atmospheres": [
    {
      "id": "atm0",
      "text": "The dome overhead is open to a sky absolutely full of stars.",
      "mood": "bright",
      "time": "night",
      "zones": [
        "any"
      ]
    },
    {
      "id": "atm1",
      "text": "It's quiet up here, above whatever's happening in the rest of the castle.",
      "mood": "calm",
      "time": "any",
      "zones": [
        "any"
      ]
    },
    {
      "id": "atm2",
      "text": "A telescope somewhere nearby adjusts its own focus with a soft click.",
      "mood": "eerie",
      "time": "any",
      "zones": [
        "any"
      ]
    },
    {
      "id": "atm3",
      "text": "The wind up here carries farther than it should, and colder.",
      "mood": "eerie",
      "time": "night",
      "zones": [
        "any"
      ]
    },
    {
      "id": "atm4",
      "text": "Dust motes drift past, lit gold by a lamp that shouldn't reach this far.",
      "mood": "calm",
      "time": "any",
      "zones": [
        "any"
      ]
    },
    {
      "id": "atm5",
      "text": "Somewhere a chart rustles, though every window is closed.",
      "mood": "eerie",
      "time": "any",
      "zones": [
        "any"
      ]
    },
    {
      "id": "atm6",
      "text": "The stars overhead seem, just slightly, not quite in their usual places.",
      "mood": "eerie",
      "time": "night",
      "zones": [
        "any"
      ]
    },
    {
      "id": "atm7",
      "text": "A comfortable hush fills the tower, like the sky itself is listening.",
      "mood": "quiet",
      "time": "any",
      "zones": [
        "any"
      ]
    }
  ],
