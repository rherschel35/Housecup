  "choice_lines": {
    "feed_good": [
      "{The} takes it with what might be gratitude, and leaves something in exchange."
    ],
    "feed_meh": [
      "{The} isn't interested and goes back to what it was doing."
    ],
    "follow_good": [
      "You follow {the} up a stair you didn't know was there, and it's worth the climb.",
      "{The} leads you to a view of the sky you've never seen from here - then it's gone."
    ],
    "follow_lost": [
      "You follow {the} in circles around the dome before giving up."
    ],
    "steal_good": [
      "You take it quickly. {The} doesn't react at all. Somehow that's unsettling."
    ],
    "steal_caught": [
      "{The} notices at once. You leave with nothing and a strange, watched feeling."
    ],
    "leave": [
      "You leave {the} to its work and step back quietly.",
      "You decide not to disturb it. The sky feels like it's watching either way."
    ],
    "tend": [
      "You water the little star-flower and turn its pot toward the open dome."
    ],
    "uproot": [
      "You pull it up. The soil beneath is oddly cold, like it remembers the sky."
    ]
  },
  "offer_lines": {
    "full": "The tower has had enough offerings left on its shelves for one day. Yours sits there, untouched.",
    "warm": [
      "Your offering catches starlight and seems, briefly, to glow.",
      "The tower feels a little warmer toward you as you leave your offering."
    ],
    "cold": [
      "Your offering just sits there under the open dome. Nothing comes for it.",
      "The night takes it without any particular notice."
    ]
  },
