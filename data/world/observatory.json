  "outcomes": [
    {
      "id": "out0",
      "text": "The sky overhead seems to arrange itself a little more clearly for you.",
      "tones": [
        "beloved",
        "friendly"
      ]
    },
    {
      "id": "out1",
      "text": "A telescope swings gently to point exactly where you were about to look.",
      "tones": [
        "beloved"
      ]
    },
    {
      "id": "out2",
      "text": "The night stays calm and the stars stay put. Nothing unusual, tonight.",
      "tones": [
        "neutral",
        "friendly"
      ]
    },
    {
      "id": "out3",
      "text": "The wind settles, just for a moment, like the tower itself exhaled.",
      "tones": [
        "friendly"
      ]
    },
    {
      "id": "out4",
      "text": "A chart flutters shut on its own as you approach.",
      "tones": [
        "wary"
      ]
    },
    {
      "id": "out5",
      "text": "The compass needle spins hard, once, and then stills pointed straight at you.",
      "tones": [
        "wary",
        "hostile"
      ]
    },
    {
      "id": "out6",
      "text": "Every telescope in the room turns, very slightly, to follow you.",
      "tones": [
        "hostile"
      ]
    },
    {
      "id": "out7",
      "text": "The stars overhead seem to dim, just for you, just for a second.",
      "tones": [
        "hostile"
      ]
    },
    {
      "id": "out8",
      "text": "A cold gust rolls through the open dome, carrying no particular warning.",
      "tones": [
        "wary"
      ]
    },
    {
      "id": "out9",
      "text": "You feel distinctly like something up there is taking notes on you.",
      "tones": [
        "wary"
      ]
    }
  ],
