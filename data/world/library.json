  "choice_lines": {
    "feed_good": [
      "{The} seems satisfied and settles back onto its shelf, leaving something behind."
    ],
    "feed_meh": [
      "{The} ignores your offering entirely and goes back to what it was doing."
    ],
    "follow_good": [
      "You follow {the} down a row you've never noticed before, and it shows you something worth finding.",
      "{The} leads you between two shelves that shouldn't fit a person - and then it's gone."
    ],
    "follow_lost": [
      "You follow {the} for what feels like ten minutes. You're back where you started."
    ],
    "steal_good": [
      "You take it while {the} isn't looking. Nothing chases you. That's somehow worse."
    ],
    "steal_caught": [
      "{The} notices immediately. You leave empty-handed, faintly embarrassed."
    ],
    "leave": [
      "You let {the} be and step quietly on. The Library, if it noticed, says nothing.",
      "You leave {the} to whatever it was doing. Some things aren't yours to disturb."
    ],
    "tend": [
      "You water it, turn its pot toward the light, and leave it a little better than you found it.",
      "You pinch off a dead leaf and settle the soil. It seems to sit up straighter."
    ],
    "uproot": [
      "You pull it out of the stack of books entirely. Something about the shelf feels wrong now.",
      "It comes free easily. The books beneath it are strangely warm."
    ]
  },
  "offer_lines": {
    "full": "The Library accepts your offering politely and files it away somewhere you'll never find it again.",
    "warm": [
      "The offering is quietly shelved, as if it belongs there.",
      "A lamp brightens, just slightly, as you leave your offering behind."
    ],
    "cold": [
      "Your offering disappears from where you left it. No acknowledgment.",
      "The Library takes it without comment. You're not sure it noticed you at all."
    ]
  },
