  "atmospheres": [
    {
      "id": "atm0",
      "text": "Dust hangs in a shaft of light, completely undisturbed.",
      "mood": "calm",
      "time": "any",
      "zones": [
        "any"
      ]
    },
    {
      "id": "atm1",
      "text": "Somewhere close by, a page turns on its own.",
      "mood": "eerie",
      "time": "any",
      "zones": [
        "any"
      ]
    },
    {
      "id": "atm2",
      "text": "It's so quiet you can hear your own heartbeat.",
      "mood": "quiet",
      "time": "any",
      "zones": [
        "any"
      ]
    },
    {
      "id": "atm3",
      "text": "A dozen candles burn without a single one of them flickering.",
