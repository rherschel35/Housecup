  "outcomes": [
    {
      "id": "out0",
      "text": "The shelves seem to lean very slightly out of your way.",
      "tones": [
        "beloved",
        "friendly"
      ]
    },
    {
      "id": "out1",
      "text": "A reading lamp brightens on its own as you pass, just for you.",
      "tones": [
        "beloved"
      ]
    },
    {
      "id": "out2",
      "text": "Nothing troubles you here. It's just a library, tonight.",
      "tones": [
        "neutral",
        "friendly"
      ]
    },
    {
      "id": "out3",
      "text": "A book slides an inch off its shelf, as if offered.",
      "tones": [
        "beloved",
        "friendly"
      ]
    },
    {
      "id": "out4",
      "text": "The silence feels companionable rather than watchful.",
      "tones": [
        "friendly",
        "neutral"
      ]
    },
    {
      "id": "out5",
      "text": "A chill draft follows you between two shelves, then gives up.",
      "tones": [
        "wary"
      ]
    },
    {
      "id": "out6",
      "text": "You feel distinctly like you're being reshelved along with everything else.",
      "tones": [
        "wary",
        "hostile"
      ]
    },
    {
      "id": "out7",
      "text": "A card catalogue drawer slams shut as you walk by. On purpose, you're fairly sure.",
      "tones": [
        "hostile"
      ]
    },
    {
      "id": "out8",
      "text": "The lamp above you gutters, then steadies, as if deciding something about you.",
      "tones": [
        "wary"
      ]
    },
    {
      "id": "out9",
      "text": "Every book on the nearest shelf turns very slightly to face you.",
      "tones": [
        "hostile"
      ]
    }
  ],
