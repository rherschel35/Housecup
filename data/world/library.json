      "mood": "quiet",
      "time": "night",
      "zones": [
        "any"
      ]
    },
    {
      "id": "atm7",
      "text": "A cold draft moves between the shelves, though every window is shut.",
      "mood": "eerie",
      "time": "night",
      "zones": [
        "any"
      ]
    },
    {
      "id": "atm8",
      "text": "The reading lamps have all dimmed themselves to a comfortable, sleepy gold.",
      "mood": "calm",
      "time": "any",
      "zones": [
        "any"
      ]
    },
    {
